# Contact form email delivery (https://resend.com)
# Without RESEND_API_KEY the form still works: submissions are validated and
# logged to the server console instead of being emailed.
RESEND_API_KEY=

# Inbox that receives enquiries. Defaults to `placeholders.email` in src/content/site.ts
CONTACT_TO_EMAIL=

# Must be a sender on a domain you've verified in Resend.
# `onboarding@resend.dev` works for testing but only delivers to your own address.
CONTACT_FROM_EMAIL="Metis Tech Studio <team@metistechstudio.com>"
