# ─── dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── build output ────────────────────────────────────────────────────────────
/.next/
/out/
/build
/coverage
.turbo

# `next-env.d.ts` and the tsbuildinfo cache are both regenerated by `next
# build`, so committing them only produces conflicts.
next-env.d.ts
*.tsbuildinfo

# ─── secrets ─────────────────────────────────────────────────────────────────
# Every .env file is ignored EXCEPT the example. `.env.example` carries no
# values — it is the list of variables a new machine has to set, and it is
# useless to everyone if it never reaches the repo. The bare `.env*` rule this
# file shipped with was swallowing it.
.env*
!.env.example
*.pem

# ─── hosting ─────────────────────────────────────────────────────────────────
.vercel

# ─── logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── agent / tooling docs ────────────────────────────────────────────────────
# Instructions for AI coding tools, not for the people running this project.
# AGENTS.md is regenerated by `next dev` on every run, so ignoring it also
# stops it reappearing as a dirty file. README.md and DESIGN.md are real
# documentation and stay tracked.
CLAUDE.md
AGENTS.md
.claude/
.cursor/
.aider*

# ─── editors and OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
